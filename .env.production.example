# Security
DEBUG=must-be-false/0
SECRET_KEY=replace-with-a-strong-production-secret
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ADMIN_URL_PATH=sarig-control-panel/
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Database (Postgres)
POSTGRES_DB=secret
POSTGRES_USER=secret_user
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional API metadata
API_V1_SUNSET=2026-12-31

# JWT
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1
JWT_ROTATE_REFRESH_TOKENS=1
JWT_BLACKLIST_AFTER_ROTATION=1
JWT_ALGORITHM=HS256
JWT_AUTH_HEADER_TYPE=Bearer
# Optional: set a dedicated JWT signing key (otherwise SECRET_KEY is used)
JWT_SIGNING_KEY=replace-with-a-strong-jwt-signing-key

# PayMongo
PAYMONGO_SECRET_KEY=replace-with-paymongo-secret-key
PAYMONGO_WEBHOOK_SECRET=replace-with-paymongo-webhook-secret
PAYMONGO_USE_MOCK=0

# Rate limiting
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=200/min
DRF_THROTTLE_AUTH=10/min
DRF_THROTTLE_REGISTRATION=5/hour
DRF_THROTTLE_ONBOARDING=10/hour
DRF_THROTTLE_CHECKOUT=20/hour
DRF_THROTTLE_PAYMENT_WEBHOOK=120/min
DRF_THROTTLE_SEARCH=60/min
