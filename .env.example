# --- Django Core ---
DEBUG=True
SECRET_KEY=dev-secret-key-change-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Infrastructure ---
# Django Channels strictly requires Redis:
REDIS_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/0

# Celery supports Redis (default) or RabbitMQ (for Windows users):
# CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672/

# --- JWT Configuration ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_ALGORITHM=HS256
JWT_AUTH_HEADER_TYPE=Bearer

# --- Payment Gateways ---
PAYMONGO_SECRET_KEY=sk_test_placeholder
PAYMONGO_WEBHOOK_SECRET=wh_placeholder

# --- API Settings ---
API_V1_SUNSET=2026-12-31
CORS_ALLOW_ALL_ORIGINS=True
ENABLE_FCM_PUSH=False
FCM_SERVER_KEY=

# --- Media Storage (Production) ---
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Ngrok ---
NGROK_AUTHTOKEN=your_authtoken_here
