# --- Django Core ---
DEBUG=True
SECRET_KEY=dev-secret-key-change-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Infrastructure ---
# Django Channels strictly requires Redis:
REDIS_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/0
USE_POSTGIS=False
# GDAL path is optional and mainly needed on some Windows setups:
# GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\17\bin\gdalXXX.dll

# Celery supports Redis (default) or RabbitMQ (for Windows users):
# CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672/

# --- JWT Configuration ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_ALGORITHM=HS256
JWT_AUTH_HEADER_TYPE=Bearer

# --- Payment Gateways ---
PAYMONGO_SECRET_KEY=sk_test_placeholder
PAYMONGO_WEBHOOK_SECRET=wh_placeholder
PAYMONGO_SUCCESS_URL=http://localhost:3000/orders/payment/success
PAYMONGO_CANCEL_URL=http://localhost:3000/orders/payment/cancelled
PAYMONGO_USE_MOCK=True

# --- API Settings ---
API_V1_SUNSET=2026-12-31
CORS_ALLOW_ALL_ORIGINS=True
ENABLE_FCM_PUSH=False
FCM_SERVER_KEY=

# --- Media Storage (Production) ---
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Ngrok ---
NGROK_AUTHTOKEN=your_authtoken_here

# --- Location Services ---
GEOAPIFY_API_KEY=your_geoapify_api_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
LOCATION_ENABLE_EXTERNAL_APIS=True
LOCATION_PROVIDER_TIMEOUT_SECONDS=8
LOCATION_COUNTRY_CODES=ph
LOCATION_BIAS_LATITUDE=8.003400
LOCATION_BIAS_LONGITUDE=124.283900
DELIVERY_BASE_FEE=40.00
DELIVERY_PER_KM_FEE=10.00
DELIVERY_MIN_FEE=40.00
DELIVERY_MAX_DISTANCE_KM=30
