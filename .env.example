# --- Django Core ---
DEBUG=True
SECRET_KEY=dev-secret-key-change-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Infrastructure ---
# Django Channels strictly requires Redis:
REDIS_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/0
USE_POSTGIS=False
# GDAL path is optional and mainly needed on some Windows setups:
# GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\17\bin\gdalXXX.dll

# Use these when running with Docker Compose or a local PostGIS database:
POSTGRES_DB=delivery_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery supports Redis (default) or RabbitMQ (for Windows users):
# CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672/

# --- JWT Configuration ---
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_ALGORITHM=HS256
JWT_AUTH_HEADER_TYPE=Bearer
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_SESSION_REFRESH_HOURS=8
AUTH_ADMIN_REMEMBER_DAYS=7
AUTH_MERCHANT_REMEMBER_DAYS=30
AUTH_CUSTOMER_REMEMBER_DAYS=30
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Payment Gateways ---
PAYMONGO_SECRET_KEY=sk_test_placeholder
PAYMONGO_WEBHOOK_SECRET=wh_placeholder
PAYMONGO_SUCCESS_URL=http://localhost:3000/orders/payment/success
# Used when the customer leaves the PayMongo checkout (cancel/back) or a payment fails.
PAYMONGO_CANCEL_URL=http://localhost:3000/marketplace
PAYMONGO_ENABLED_PAYMENT_METHODS=GCASH,MAYA,CARD
PAYMONGO_USE_MOCK=True

# --- API Settings ---
API_V1_SUNSET=2026-12-31
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DRF_THROTTLE_CHECKOUT=60/hour
DRF_THROTTLE_CHECKOUT_QUOTE=120/min
ENABLE_FCM_PUSH=False
FCM_SERVER_KEY=

# Optional onboarding notification providers
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@sarig.local
FRONTEND_BASE_URL=http://localhost:3000
# Dotted callable accepting recipient, message, and idempotency_key keyword arguments.
ONBOARDING_SMS_BACKEND=

# --- Media Storage (Production) ---
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Ngrok ---
NGROK_AUTHTOKEN=your_authtoken_here

# --- Location Services ---
GEOAPIFY_API_KEY=your_geoapify_api_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
LOCATION_ENABLE_EXTERNAL_APIS=True
LOCATION_PROVIDER_TIMEOUT_SECONDS=8
LOCATION_COUNTRY_CODES=ph
LOCATION_BIAS_LATITUDE=8.003400
LOCATION_BIAS_LONGITUDE=124.283900
DELIVERY_BASE_FEE=40.00
DELIVERY_PER_KM_FEE=10.00
DELIVERY_MIN_FEE=40.00
DELIVERY_MAX_DISTANCE_KM=30
DELIVERY_SAVER_FEE_MULTIPLIER=0.85
DELIVERY_PRIORITY_FEE_MULTIPLIER=1.25
DELIVERY_SAVER_EXTRA_MINUTES=10
DELIVERY_PRIORITY_REDUCED_MINUTES=5
ORDER_SYSTEM_FEE=10.00
ORDER_DEFAULT_PREPARATION_MINUTES=10
